<div class="container mx-auto px-4 py-8 max-w-6xl">
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {gettext("Upload media")}
    </h2>

    <form
      id="upload-form"
      phx-change="validate"
      class="space-y-4"
    >
      <div
        id="upload-drop-zone"
        phx-drop-target={@uploads.media.ref}
        phx-hook="DragDropZone"
        class="border-2 border-dashed rounded-lg p-8 text-center cursor-pointer transition-all duration-200 border-gray-300 hover:border-gray-400 dark:border-gray-600 dark:hover:border-gray-500"
        data-active-class="border-emerald-600 bg-emerald-100 dark:bg-emerald-900/20"
      >
        <.live_file_input upload={@uploads.media} class="hidden" />
        <p class="text-gray-600 dark:text-gray-300">
          {gettext("Drag & drop or")}
          <label
            for={@uploads.media.ref}
            class="text-emerald-500 font-medium hover:text-emerald-600 cursor-pointer"
          >
            {gettext("select file")}
          </label>
        </p>
      </div>

      <p :for={err <- upload_errors(@uploads.media)} class="text-red-500 text-sm">
        {upload_error_to_string(err)}
      </p>

      <div :if={Enum.count(@uploads.media.entries) > 0} class="space-y-3">
        <div
          :for={entry <- @uploads.media.entries}
          class="bg-gray-100 dark:bg-gray-800 rounded-lg p-4"
        >
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-3">
              <.icon name="hero-document-arrow-up" class="h-5 w-5 text-emerald-500" />

              <span class="text-sm text-gray-700 dark:text-gray-300 truncate max-w-xs">
                {entry.client_name}
              </span>
            </div>
            <button
              type="button"
              phx-click="cancel-upload"
              phx-value-ref={entry.ref}
              class="text-red-500 hover:text-red-700"
              aria-label={gettext("Cancel upload")}
            >
              <.icon name="hero-x-mark" class="h-5 w-5" />
            </button>
          </div>

          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
            <div
              class="bg-emerald-500 h-2 rounded-full transition-all duration-300"
              style={"width: #{entry.progress}%"}
            >
            </div>
          </div>

          <p
            :for={err <- upload_errors(@uploads.media, entry)}
            class="text-red-500 text-xs mt-1"
          >
            {upload_error_to_string(err)}
          </p>
        </div>
      </div>
    </form>

    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
      {supported_formats_text(nil)}
    </p>
  </section>

  <section>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        {gettext("Media library")}
      </h2>

      <div class="flex items-center gap-3">
        <.form
          :let={f}
          class="w-60"
          for={to_form(%{"query" => @query})}
          phx-change="search"
          phx-submit="search"
        >
          <.input
            type="search"
            field={f[:query]}
            placeholder={gettext("Search by name")}
            class="input w-full"
            phx-debounce="300"
            autocomplete="off"
          />
        </.form>

        <.form
          :let={f}
          for={to_form(%{"media_type" => @media_type})}
          phx-change="filter_media_type"
        >
          <.input
            type="select"
            field={f[:media_type]}
            options={[
              {gettext("All types"), ""},
              {gettext("Image"), "image"},
              {gettext("Video"), "video"},
              {gettext("Lottie"), "lottie"}
            ]}
          />
        </.form>
      </div>
    </div>

    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
      <%= for item <- @media_items do %>
        <div class="group relative bg-gray-200 dark:bg-gray-700 rounded-lg overflow-hidden p-2">
          <div class="relative w-full aspect-[3/2] bg-gray-200 dark:bg-gray-700 rounded-lg overflow-hidden">
            <%= case item.type do %>
              <% "image" -> %>
                <img
                  src={ScalesCms.Cms.Helpers.S3Upload.get_presigned_url_for_display(item.url)}
                  class="absolute inset-0 w-full h-full object-cover"
                  alt={item.name}
                />
              <% "video" -> %>
                <div class="absolute inset-0 bg-gradient-to-br from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 flex items-center justify-center">
                  <.icon
                    name="hero-video-camera"
                    class="h-12 w-12 text-gray-400 dark:text-gray-500"
                  />
                </div>
              <% "lottie" -> %>
                <div class="absolute inset-0 bg-gradient-to-br from-purple-200 to-purple-300 dark:from-purple-800 dark:to-purple-900 flex items-center justify-center">
                  <.icon
                    name="hero-sparkles"
                    class="h-12 w-12 text-purple-400 dark:text-purple-300"
                  />
                </div>
              <% _ -> %>
                <div class="absolute inset-0 bg-gradient-to-br from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 flex items-center justify-center">
                  <.icon name="hero-photo" class="h-12 w-12 text-gray-400 dark:text-gray-500" />
                </div>
            <% end %>

            <button
              phx-click="show_delete_modal"
              phx-value-id={item.id}
              class="absolute h-[24px] w-[24px] top-2 right-2 bg-white hover:bg-gray-200 rounded text-red-500 transition-colors"
            >
              <.icon name="hero-trash" class="h-[14px] w-[12px]" />
            </button>

            <div class="absolute bottom-2 left-2">
              <span class={"px-2 py-0.5 text-xs font-medium rounded #{type_badge_class(item.type)}"}>
                {item.type}
              </span>
            </div>
          </div>

          <div class="mt-2">
            <p class="text-xs text-gray-900 dark:text-white truncate" title={item.name}>
              {item.name}
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">
              {Calendar.strftime(item.inserted_at, "%d-%m-%Y")}
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <.modal
      id="delete-media-modal"
      on_cancel={JS.push("hide_delete_modal")}
    >
      <div class="text-center">
        <.icon name="hero-exclamation-triangle" class="h-12 w-12 mx-auto text-red-500 mb-4" />
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {gettext("Delete media item")}
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          {gettext("Are you sure you want to remove this item from the media library?")}
        </p>
        <div class="flex justify-center gap-4">
          <button
            type="button"
            phx-click="hide_delete_modal"
            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg transition-colors"
          >
            {gettext("Cancel")}
          </button>
          <button
            type="button"
            phx-click="confirm_delete"
            class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors"
          >
            {gettext("Delete")}
          </button>
        </div>
      </div>
    </.modal>

    <%!-- Empty State (shown when no items) --%>
    <%= if Enum.empty?(@media_items) do %>
      <div class="text-center py-12">
        <.icon name="hero-photo" class="h-16 w-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" />
        <p class="text-gray-500 dark:text-gray-400">
          {gettext("No media files uploaded yet.")}
        </p>
      </div>
    <% end %>
  </section>
</div>
