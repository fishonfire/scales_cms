<div id={@id}>
  <.modal id={"#{@id}-modal"} show={true} on_cancel={close_modal_action(@target, @myself)}>
    <div class="max-h-[80vh] overflow-y-auto">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        {gettext("Media Library")}
      </h2>

      <section class="mb-8">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
          {gettext("Upload media")}
        </h3>

        <form
          id={"#{@id}-upload-form"}
          phx-change="validate"
          phx-target={@myself}
          class="space-y-4"
        >
          <div
            id={"#{@id}-drop-zone"}
            phx-drop-target={@uploads.media.ref}
            phx-hook="DragDropZone"
            data-target={@myself}
            class="border-2 border-dashed rounded-lg p-8 text-center cursor-pointer transition-all duration-200 border-gray-300 hover:border-gray-400 dark:border-gray-600 dark:hover:border-gray-500"
            data-active-class="border-emerald-600 bg-emerald-100 dark:bg-emerald-900/20"
          >
            <.live_file_input upload={@uploads.media} class="hidden" />
            <p class="text-gray-600 dark:text-gray-300">
              {gettext("Drag & drop or")}
              <label
                for={@uploads.media.ref}
                class="text-emerald-500 font-medium hover:text-emerald-600 cursor-pointer"
              >
                {gettext("select file")}
              </label>
            </p>
          </div>

          <p :for={err <- upload_errors(@uploads.media)} class="text-red-500 text-sm">
            {upload_error_to_string(err)}
          </p>

          <%= if Enum.count(@uploads.media.entries) > 0 do %>
            <div class="space-y-3">
              <div
                :for={entry <- @uploads.media.entries}
                class="bg-gray-100 dark:bg-gray-800 rounded-lg p-3"
              >
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-3">
                    <.icon name="hero-document-arrow-up" class="h-4 w-4 text-emerald-500" />
                    <span class="text-sm text-gray-700 dark:text-gray-300 truncate max-w-xs">
                      {entry.client_name}
                    </span>
                  </div>
                  <button
                    type="button"
                    phx-click="cancel-upload"
                    phx-target={@myself}
                    phx-value-ref={entry.ref}
                    class="text-red-500 hover:text-red-700"
                    aria-label={gettext("Cancel upload")}
                  >
                    <.icon name="hero-x-mark" class="h-4 w-4" />
                  </button>
                </div>

                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-1.5">
                  <div
                    class="bg-emerald-500 h-1.5 rounded-full transition-all duration-300"
                    style={"width: #{entry.progress}%"}
                  >
                  </div>
                </div>

                <p
                  :for={err <- upload_errors(@uploads.media, entry)}
                  class="text-red-500 text-xs mt-1"
                >
                  {upload_error_to_string(err)}
                </p>

                <%= if entry.progress == 100 do %>
                  <p class="text-emerald-500 text-xs mt-1 flex items-center gap-1">
                    <.icon name="hero-check-circle" class="h-3 w-3" />
                    {gettext("Saved")}
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        </form>

        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
          {supported_formats_text(@filter_type)}
        </p>
      </section>

      <section>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {gettext("Select from library")}
          </h3>

          <div class="flex items-center gap-2">
            <.form
              :let={f}
              class="w-48"
              for={to_form(%{"query" => @query})}
              phx-change="search"
              phx-submit="search"
              phx-target={@myself}
            >
              <.input
                type="search"
                field={f[:query]}
                placeholder={gettext("Search by name")}
                class="input w-full text-sm"
                phx-debounce="300"
                autocomplete="off"
              />
            </.form>

            <%= if is_nil(@filter_type) do %>
              <.form
                :let={f}
                for={to_form(%{"media_type" => @media_type})}
                phx-change="filter_media_type"
                phx-target={@myself}
              >
                <.input
                  type="select"
                  field={f[:media_type]}
                  options={[
                    {gettext("All types"), ""},
                    {gettext("Image"), "image"},
                    {gettext("Video"), "video"},
                    {gettext("Lottie"), "lottie"}
                  ]}
                />
              </.form>
            <% else %>
              <span class={"px-3 py-1.5 text-sm font-medium rounded-lg #{type_badge_class(@filter_type)}"}>
                {String.capitalize(@filter_type)}
              </span>
            <% end %>
          </div>
        </div>

        <div
          class="grid gap-3 max-h-[300px] overflow-y-auto p-2 -m-2"
          style="grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));"
        >
          <%= for item <- @media_items do %>
            <div
              class="group relative bg-gray-200 dark:bg-gray-700 rounded-lg overflow-hidden p-1.5 cursor-pointer border-2 border-transparent hover:border-emerald-500 transition-all"
              phx-click={select_media_action(@target, @myself, item.id)}
              phx-value-id={item.id}
            >
              <div class="relative w-full aspect-square bg-gray-200 dark:bg-gray-700 rounded overflow-hidden">
                <%= case item.type do %>
                  <% "image" -> %>
                    <img
                      src={S3Upload.get_presigned_url_for_display(item.url)}
                      class="absolute inset-0 w-full h-full object-cover"
                      alt={item.name}
                    />
                  <% "video" -> %>
                    <div class="absolute inset-0 bg-gradient-to-br from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 flex items-center justify-center">
                      <.icon
                        name="hero-video-camera"
                        class="h-8 w-8 text-gray-400 dark:text-gray-500"
                      />
                    </div>
                  <% "lottie" -> %>
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-200 to-purple-300 dark:from-purple-800 dark:to-purple-900 flex items-center justify-center">
                      <.icon
                        name="hero-sparkles"
                        class="h-8 w-8 text-purple-400 dark:text-purple-300"
                      />
                    </div>
                  <% _ -> %>
                    <div class="absolute inset-0 bg-gradient-to-br from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 flex items-center justify-center">
                      <.icon name="hero-photo" class="h-8 w-8 text-gray-400 dark:text-gray-500" />
                    </div>
                <% end %>

                <div class="absolute bottom-1 left-1">
                  <span class={"px-1.5 py-0.5 text-[10px] font-medium rounded #{type_badge_class(item.type)}"}>
                    {item.type}
                  </span>
                </div>
              </div>

              <p
                class="text-[10px] text-gray-900 dark:text-white truncate mt-1"
                title={item.name}
              >
                {item.name}
              </p>
            </div>
          <% end %>
        </div>

        <%= if Enum.empty?(@media_items) do %>
          <div class="text-center py-8">
            <.icon
              name="hero-photo"
              class="h-12 w-12 mx-auto text-gray-300 dark:text-gray-600 mb-3"
            />
            <p class="text-gray-500 dark:text-gray-400 text-sm">
              {gettext("No media files found.")}
            </p>
          </div>
        <% end %>
      </section>
    </div>
  </.modal>
</div>
