<div>
  <.live_component
    id={"head-#{@block.id}"}
    module={BlockWrapper}
    block={@block}
    component={ScalesCmsWeb.Components.CmsComponents.Image}
    published={@published}
  >
    <div class="flex items-start gap-4">
      <div class="w-[200px] h-[200px]">
        <img
          :if={Map.get(@block.properties || %{}, "image_path", nil) != nil}
          src={
            S3Upload.get_presigned_url_for_display(
              Map.get(@block.properties || %{}, "image_path", nil)
            )
          }
          class="object-cover rounded-lg"
        />
      </div>

      <.media_library_button
        modal_id={"media-library-modal-#{@block.id}-modal"}
        type="image"
        disabled={@disabled}
      />
    </div>

    <.live_component
      module={MediaLibraryModal}
      id={"media-library-modal-#{@block.id}"}
      filter_type="image"
      target={@myself}
    />
  </.live_component>
</div>
